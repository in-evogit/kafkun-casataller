# ─── PÚBLICAS (cliente puede ver) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://kafkun-casataller.vercel.app
NEXT_PUBLIC_BUSINESS_MODE=development

# ─── PRIVADAS (solo server) ────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — SANDBOX en modo dev (prefijo TEST-)
MP_ACCESS_TOKEN=TEST-
MP_WEBHOOK_SECRET=
MP_MODE=sandbox

# Mux Video
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Resend — el cartero del sitio: avisos de encargo, confirmaciones y el
# enlace de acceso del login.
#
# OJO: sin un DOMINIO VERIFICADO en Resend solo se puede escribir a la
# direccion dueña de la cuenta. Con onboarding@resend.dev no le llega
# nada a los clientes.
RESEND_API_KEY=
RESEND_FROM=hola@tu-dominio.cl

# A donde llegan los avisos de encargo y de contacto. Sin esto cae en el
# correo personal de Gabriel (lib/email.ts).
ADMIN_EMAIL=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_AUTH_TOKEN=

# Cron — el latido que mantiene despierta la base de datos.
# Supabase pausa un proyecto sin consultas y despues lo borra (paso DOS veces).
# El trafico de la web NO cuenta: el sitio publico no consulta la base.
# Vercel firma la llamada diaria con este secreto; cualquier cadena larga sirve.
CRON_SECRET=

# Boletas SII — DESACTIVADO en dev
BOLETA_AUTO_ENABLED=false
OPENFACTURA_API_KEY=
EMPRESA_RUT=
EMPRESA_RAZON_SOCIAL=
EMPRESA_DIRECCION=
EMPRESA_COMUNA=
EMPRESA_CIUDAD=
